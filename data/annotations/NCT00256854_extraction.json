{
  "nct_id": "NCT00256854",
  "therapeutic_hypothesis": {
    "compound": "Ropinirole CR (controlled-release)",
    "claimed_target": "dopamine D2/D3 receptor",
    "proposed_mechanism": "receptor agonism",
    "intended_biology": "dopaminergic modulation of sensorimotor symptoms",
    "target_population": "Adults with Restless Legs Syndrome (RLS) previously stabilized on ropinirole immediate-release",
    "primary_endpoint": "Number of participants with adverse events post-conversion from ropinirole IR to ropinirole CR over up to 5 weeks",
    "rationale_strength": "strong"
  },
  "results": {
    "primary_endpoint_met": true,
    "effect_size": "AEs reported in 9\u201314 participants per cohort post-conversion 1 and 5\u20138 per cohort post-conversion 2; no SAEs observed post-conversion",
    "p_value": null,
    "target_engagement_evidence": null,
    "biomarker_changes": [
      "IRLS total score improved (decreased) in most cohorts post-conversion to CR (range -5.8 to +1.2 post-conversion 1; range -5.2 to +0.6 post-conversion 2)",
      "Ambulatory SBP decreased by up to ~20 mmHg at some timepoints post-dose",
      "Ambulatory DBP decreased by up to ~23 mmHg at some timepoints post-dose"
    ],
    "subgroup_findings": [
      "No SAEs were reported in any cohort post-conversion 1 or post-conversion 2",
      "Most AEs were mild to moderate in severity across all cohorts",
      "Majority of participants showed positive CGI-I scores (improvement) post-conversion in both conversion periods",
      "IRLS score improvements were generally maintained or enhanced after conversion to CR formulation",
      "Orthostatic blood pressure changes were small and generally not clinically concerning across cohorts",
      "Isolated DBP PCC-high values noted in Cohort B post-conversion to 3 mg CR (6 participants)"
    ],
    "safety_signals": [
      "Palpitations reported as SAE in 1/52 participants in Cohort A",
      "Most AEs were mild to moderate; severe AEs occurred in small numbers across cohorts",
      "2 participants discontinued due to AEs post-conversion 1 (1 each in Cohorts B1 and B2); no discontinuations post-conversion 2",
      "No SAEs reported post-conversion in any cohort"
    ],
    "dose_info": {
      "dose": "Ropinirole CR 2 mg, 3 mg, or 6 mg (depending on cohort); Ropinirole IR 1 mg, 2 mg, or 4 mg (depending on cohort)",
      "schedule": "Once daily (CR); IR dosing per cohort assignment",
      "max_tolerated_dose": "",
      "dose_modifications": ""
    },
    "adverse_events": [
      {
        "term": "Palpitations",
        "grade": "",
        "incidence_treatment_pct": 1.92,
        "incidence_control_pct": null,
        "serious": true
      }
    ]
  },
