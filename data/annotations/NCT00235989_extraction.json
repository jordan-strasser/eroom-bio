{
  "nct_id": "NCT00235989",
  "therapeutic_hypothesis": {
    "compound": "Interferon beta-1b (Betaseron)",
    "claimed_target": "type I interferon receptor (IFNAR)",
    "proposed_mechanism": "cytokine receptor agonism",
    "intended_biology": "immunomodulation reducing neuroinflammation",
    "target_population": "Patients with relapsing-remitting multiple sclerosis enrolled in extension of prior dose-comparison study",
    "primary_endpoint": "Safety and tolerability defined by incidence of flu-like syndrome, fever, myalgia, injection site reactions, injection site reaction pain, asthenia, headache, liver function abnormalities, and bone marrow function abnormalities at week 234",
    "rationale_strength": "strong"
  },
  "results": {
    "primary_endpoint_met": true,
    "effect_size": "Most toxicities were Grade 1; no Grade 2\u20134 liver or bone marrow toxicities except isolated cases; serious AEs were infrequent",
    "p_value": null,
    "target_engagement_evidence": "Neutralizing antibody titers to IFN beta-1b monitored across arms; at week 234, NAb titers \u226520 NU/ml present in 2\u20135 patients per arm",
    "biomarker_changes": [
      "NAb titer \u226520 NU/ml at week 234: 250\u2192250 mcg: 2 patients; 500\u2192250 mcg: 0 patients; 500\u2192500 mcg: 5 patients; 250\u2192500 mcg: 3 patients",
      "NAb titer \u2265100 NU/ml at week 234: 250\u2192250 mcg: 1; 500\u2192250 mcg: 0; 500\u2192500 mcg: 2; 250\u2192500 mcg: 2",
      "NAb titer \u2265400 NU/ml at week 234: 250\u2192250 mcg: 1; 500\u2192250 mcg: 0; 500\u2192500 mcg: 1; 250\u2192500 mcg: 1"
    ],
    "subgroup_findings": [
      "Flu-like syndrome most frequent in 250\u2192500 mcg arm (7 patients) and 500\u2192500 mcg arm (4 patients)",
      "Injection site reactions present across all arms (2\u20134 patients each)",
      "Grade 1 bilirubin elevations most common lab finding (4\u201314 patients per arm); no Grade 2\u20134 bilirubin toxicity except one Grade 2 in 500\u2192500 mcg arm",
      "Grade 1 ALAT elevations: 1\u20139 patients per arm; no Grade 2\u20134 ALAT toxicity",
      "Grade 1 ASAT elevations: 1\u20138 patients per arm; one Grade 2 ASAT in 250\u2192250 mcg arm",
      "Leukocyte Grade 1\u20132 toxicity present in all arms; no Grade 3\u20134",
      "Lymphocyte Grade 3 toxicity: 1 patient in 250\u2192500 mcg arm",
      "Hemoglobin Grade 3 toxicity: 1 patient in 500\u2192500 mcg arm"
    ],
    "safety_signals": [
      "Serious AEs reported only in 500\u2192500 mcg and 250\u2192250 mcg arms",
      "Necrosis (injection site) reported as SAE in 500\u2192500 mcg arm",
      "Cerebrovascular accident reported in both 250\u2192250 mcg and 500\u2192500 mcg arms",
      "Sepsis, myocardial infarction, cerebral ischemia, occlusion each reported in 500\u2192500 mcg arm",
      "Overall safety profile consistent with known interferon beta-1b tolerability"
    ],
    "dose_info": {
      "dose": "250 mcg or 500 mcg",
      "schedule": "subcutaneous every other day",
      "max_tolerated_dose": "",
      "dose_modifications": "Dose reduction or interruption recommended for Grade 2 toxicity (except Grade 2 lymphocyte toxicity); interruption recommended for Grade 3; interruption recommended and SAE reported for Grade 4"
    },
