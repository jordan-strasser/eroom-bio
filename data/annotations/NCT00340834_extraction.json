  "nct_id": "NCT00340834",
  "therapeutic_hypothesis": {
    "compound": "Fingolimod",
    "claimed_target": "S1P1 receptor (sphingosine-1-phosphate receptor 1)",
    "proposed_mechanism": "receptor functional antagonism / internalization",
    "intended_biology": "lymphocyte sequestration in lymph nodes reducing CNS inflammatory infiltration",
    "target_population": "Patients with relapsing-remitting multiple sclerosis",
    "primary_endpoint": "Annualized relapse rate (ARR) at 12 months",
    "rationale_strength": "strong"
  },
  "results": {
    "primary_endpoint_met": true,
