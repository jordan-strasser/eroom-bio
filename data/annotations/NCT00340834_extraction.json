    "p_value": null,
    "target_engagement_evidence": "Lymphopenia observed as pharmacodynamic marker of S1P1 receptor engagement",
    "biomarker_changes": [
      "New or newly enlarged T2 lesions: 1.6 (fingolimod 1.25 mg), 1.6 (fingolimod 0.5 mg) vs 2.6 (interferon \u03b2-1a) at Month 12"
    ],
    "subgroup_findings": [
      "ARR Month 12-24: fingolimod 1.25 mg 0.156, fingolimod 0.5 mg 0.182, IFN/fingolimod 0.266",
