{
  "nct_id": "NCT00804986",
  "therapeutic_hypothesis": {
    "compound": "LY2428757",
    "claimed_target": "GLP-1 receptor",
    "proposed_mechanism": "receptor agonism",
    "intended_biology": "glucose-dependent insulin secretion and glycemic regulation",
    "target_population": "Adults with type 2 diabetes mellitus",
    "primary_endpoint": "Change in HbA1c from baseline to Week 12",
    "rationale_strength": "strong"
  },
  "results": {
    "primary_endpoint_met": true,
    "effect_size": "LS mean change in HbA1c: -1.41% (12.0 mg) vs -0.13% (placebo); max difference vs placebo -1.28% (p<0.0001)",
    "p_value": 0.0001,
    "target_engagement_evidence": "Dose-proportional average plasma concentrations (Cavg) ranging from 29.5 ng/mL (0.5 mg) to 1290 ng/mL (17.6 mg) confirmed systemic drug exposure",
    "biomarker_changes": [
      "Dose-dependent reductions in fasting self-monitored glucose across all active doses vs placebo",
      "Significant reductions in total glucose AUC (OGTT) at 6.2, 12.0, and 17.6 mg doses vs placebo",
      "Increases in insulin AUC and C-peptide AUC at higher doses suggesting enhanced insulin secretory response",
      "Modest reductions in body weight at 6.2 mg (-2.12 kg) and 17.6 mg (-2.60 kg) vs placebo (-0.59 kg)",
      "No clinically meaningful changes in fasting lipids (triglycerides, HDL, LDL, total cholesterol) vs placebo"
    ],
    "subgroup_findings": [
      "Dose-dependent HbA1c reductions: -0.60% (0.5 mg), -0.80% (2.0 mg), -1.24% (6.2 mg), -1.41% (12.0 mg), -1.37% (17.6 mg) vs -0.13% placebo",
      "Significant fasting glucose reductions at 2.0 mg and above; 0.5 mg not significant vs placebo",
      "Post-prandial glucose reductions significant at 2.0 mg and above across most meal timepoints",
      "Weight loss significant vs placebo only at 6.2 mg (p=0.0123) and 17.6 mg (p=0.0013)",
      "VAS appetite and satiety scores not significantly different from placebo across all doses",
      "10 participants developed detectable anti-LY2428757 antibodies across active arms (1 placebo)"
    ],
    "safety_signals": [
      "Serious adverse events reported: acute myocardial infarction (12.0 mg, n=1), atrial fibrillation (6.2 mg, n=1), Crohn's disease (2.0 mg, n=1), urinary tract infection (2.0 mg, n=1), hypoglycaemia (0.5 mg, n=1), squamous cell carcinoma (2.0 mg, n=1), chronic obstructive pulmonary disease (2.0 mg, n=1)"
    ],
    "dose_info": {
