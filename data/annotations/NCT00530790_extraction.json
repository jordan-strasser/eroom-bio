    "biomarker_changes": [
      "Mean hemoglobin change from baseline: -2.7 G/L at week 8",
      "Mean WBC count change: -0.624 GI/L at week 13",
      "Prolactin change from baseline: +0.80 MCG/L at week 4, +1.14 MCG/L at week 13",
      "Plasma ropinirole (SK&F101468) at 0.5 mg: 310.01 pg/mL; at 4 mg: 1198.10 pg/mL",
      "Plasma metabolite SK&F104557 at 0.5 mg: 324.65 pg/mL; at 4 mg: 2541.95 pg/mL",
      "Plasma metabolite SK&F89124 at 0.5 mg: 22.45 pg/mL; at 4 mg: 72.05 pg/mL"
    ],
    "subgroup_findings": [
      "IRLS total score decreased from 25.3 at baseline to 6.0 at week 12 (change: -19.3 points)",
      "At final assessment point, 27/35 subjects rated Very Much Improved on CGI-GI",
      "PSQI total score improved from 9.4 at baseline to 5.4 at week 12/EW (change: -4.2)",
      "RLSQOL overall life impact score improved from 65.29 at baseline to 89.09 at week 12 (change: +23.94)",
      "POMS total score decreased from 59.2 at baseline to 48.0 at week 12/EW (change: -10.4)",
      "HADS anxiety score decreased from 9.3 to 7.7 (change: -1.8); depression score minimally changed from 9.7 to 9.5 (change: -0.1)"
    ],
    "safety_signals": [
      "29/35 subjects (82.9%) experienced drug-related adverse events",
      "Nausea was most common (14 events)",
      "Somnolence (5 events), vomiting (5 events), hypersomnia (3 events)",
      "Diarrhea, dizziness, dyspepsia, fatigue, stomach discomfort (2 events each)",
      "Palpitations reported in 1 subject",
      "No clinically significant ECG transitions from normal to ACS in subjects with normal baseline ECG",
      "Orthostatic pulse rate mean change +9.2 bpm"
    ],
