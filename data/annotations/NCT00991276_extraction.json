{
  "nct_id": "NCT00991276",
  "therapeutic_hypothesis": {
    "compound": "pregabalin",
    "claimed_target": "voltage-gated calcium channels (alpha-2-delta subunit)",
    "proposed_mechanism": "calcium channel modulation",
    "intended_biology": "neuronal excitability reduction and sleep architecture normalization",
    "target_population": "adults with restless legs syndrome and associated sleep disturbance",
    "primary_endpoint": "Wake After Sleep Onset (WASO) by polysomnography",
    "rationale_strength": "strong"
  },
  "results": {
    "primary_endpoint_met": true,
    "effect_size": "pregabalin vs placebo: LS mean difference -27.10 min (95% CI: -35.78 to -18.42); pregabalin vs pramipexole: LS mean difference -26.93 min (95% CI: -35.54 to -18.32)",
    "p_value": 0.0001,
    "target_engagement_evidence": null,
    "biomarker_changes": [
      "Pregabalin significantly increased Stage N3/SWS (LS mean 66.88 min vs placebo 45.95 min, p<0.0001)",
      "Pregabalin significantly reduced PLMI vs placebo (LS mean difference -14.50 movements/hour, p<0.0001)",
      "Pregabalin significantly reduced PLMSI vs placebo (LS mean difference -14.53 movements/hour, p<0.0001)",
      "Pramipexole showed greater reduction in PLMI vs placebo (LS mean difference -25.84 movements/hour, p<0.0001) and vs pregabalin (p=0.0001)",
      "Pregabalin increased TST vs placebo by 32.72 min (p<0.0001) and vs pramipexole by 25.86 min (p<0.0001)",
      "Pregabalin improved sleep efficiency vs placebo by 6.80% (p<0.0001)",
      "Pramipexole significantly delayed REM latency vs placebo (LS mean difference +46.47 min, p<0.0001) and vs pregabalin (LS mean difference -35.77 min, p<0.0001)",
      "Pregabalin reduced Stage N1 sleep vs placebo (p=0.0076) and vs pramipexole (p<0.0001)",
      "Pregabalin increased Stage N2 sleep vs placebo (p=0.0003) and vs pramipexole (p=0.0174)"
    ],
    "subgroup_findings": [
      "Pregabalin showed consistently lower WASO across all 8 hours and all 4 quarters of the night compared to both pramipexole and placebo",
      "Pramipexole showed higher WASO than placebo in hours 4-6 (second half of night)",
      "Pregabalin showed superior sleep efficiency in hours 2-6 compared to both comparators",
      "Pramipexole showed greater PLM reduction than pregabalin in all hourly and quarterly assessments"
    ],
    "safety_signals": [
      "Pregabalin: 1 SAE of orthostatic hypotension, 1 SAE of postural dizziness, 1 SAE of deep vein thrombosis",
      "Pramipexole: 1 SAE of suicidal ideation",
      "Placebo: 1 SAE of gastroenteritis, 1 SAE of hypokalemia, 1 SAE of suicidal ideation"
    ],
    "dose_info": {
      "dose": "300 mg (pregabalin); 0.5 mg (pramipexole)",
      "schedule": "once daily; 4 weeks per treatment period",
      "max_tolerated_dose": "",
      "dose_modifications": ""
    },
