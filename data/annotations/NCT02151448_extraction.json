{
  "nct_id": "NCT02151448",
  "therapeutic_hypothesis": {
    "compound": "\u03b1DC1 vaccine + chemokine modulatory regimen (celecoxib + interferon alfa-2b + rintatolimod)",
    "claimed_target": "dendritic cells",
    "proposed_mechanism": "antigen presentation enhancement",
    "intended_biology": "T-cell mediated anti-tumor immunity",
    "target_population": "peritoneal surface malignancies",
    "primary_endpoint": "recommended phase 2 dose and safety",
    "rationale_strength": "moderate"
  },
  "results": {
    "primary_endpoint_met": true,
    "effect_size": "RP2D established; median OS 52 months",
    "p_value": null,
    "target_engagement_evidence": "CXCL10 increased from 1221.5 to 16335.0 pg/mL at week 4",
    "biomarker_changes": [
      "CXCL10 increased 13-fold at week 4 (1221.5 to 16335.0 pg/mL)",
      "CXCL11 increased 36-fold at week 4 (359.4 to 12893.2 pg/mL)",
      "IL-10 increased 6.6-fold at week 4 (1.2 to 7.9 pg/mL)",
      "IL-6 increased 2.2-fold at week 4 (15.2 to 32.8 pg/mL)",
      "TNF\u03b1 increased 2.9-fold at week 4 (10.8 to 31.0 pg/mL)",
      "SDF-1A/CXCL-12 increased 1.7-fold at week 4 (1267.3 to 2160.3 pg/mL)"
    ],
    "subgroup_findings": [
      "Mesothelioma patients had median PFS not reached",
      "Colon cancer patients had median PFS 19 months",
      "Appendiceal cancer patients had median PFS 16 months"
    ],
    "safety_signals": [
      "Most common AEs were chills (53%), fatigue (23%), nausea (20%), headache (16%)",
      "Grade 3-4 AEs were rare: anemia (1.6%), diarrhea (1.6%), heart failure (1.6%)",
      "Treatment was generally well tolerated"
    ],
    "dose_info": {
      "dose": "DC vaccine 3x10e6 cells; interferon 5-20 MU/m2; rintatolimod 200 mg; celecoxib 200-400 mg",
      "schedule": "DC vaccine weekly x4 cycles; interferon Tuesday; rintatolimod Wednesday/Friday; celecoxib daily",
      "max_tolerated_dose": "20 MU/m2 interferon alfa-2b",
      "dose_modifications": "rintatolimod de-escalation to 100 mg allowed for AEs"
    },
