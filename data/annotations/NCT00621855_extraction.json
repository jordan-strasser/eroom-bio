{
  "nct_id": "NCT00621855",
  "therapeutic_hypothesis": {
    "compound": "dabigatran etexilate",
    "claimed_target": "thrombin (Factor IIa)",
    "proposed_mechanism": "direct thrombin inhibition",
    "intended_biology": "anticoagulation / thrombus formation inhibition",
    "target_population": "patients with acute coronary syndrome on background dual antiplatelet therapy",
    "primary_endpoint": "composite of major and clinically relevant minor bleeding events during 6-month treatment period plus 2-week post-treatment follow-up",
    "rationale_strength": "moderate"
  },
  "results": {
    "primary_endpoint_met": true,
    "effect_size": "dose-dependent increase in bleeding: 13 (50mg), 16 (75mg), 32 (110mg), 27 (150mg) vs 8 (placebo) participants with major or clinically relevant minor bleeding",
    "p_value": 0.001,
    "target_engagement_evidence": "D-dimer reduction: geometric mean ratio week 4/baseline 0.29\u20130.33 across dabigatran doses vs 0.57 for placebo (p<0.001)",
    "biomarker_changes": [
      "D-dimer reduced at week 1 (ratio 0.52\u20130.58 vs 0.87 placebo) and week 4 (ratio 0.29\u20130.33 vs 0.57 placebo) across all dabigatran doses",
      "Dose-dependent increase in proportion of patients with any D-dimer reduction (p<0.001)",
      "AST clinically significant increases: 2\u20138 patients across dabigatran arms vs 4 placebo",
      "ALT clinically significant increases: 4\u201310 patients across dabigatran arms vs 4 placebo",
      "Bilirubin increases: 0\u20132 patients across dabigatran arms vs 0 placebo"
    ],
    "subgroup_findings": [
      "Major bleeding: 3 (50mg), 1 (75mg), 8 (110mg), 4 (150mg) vs 2 (placebo)",
      "Clinically relevant minor bleeding: 10 (50mg), 16 (75mg), 24 (110mg), 23 (150mg) vs 6 (placebo)",
      "Any bleeding: 42 (50mg), 45 (75mg), 60 (110mg), 42 (150mg) vs 25 (placebo)",
      "CVD/non-fatal MI/non-haemorrhagic stroke composite: 17 (50mg), 18 (75mg), 12 (110mg), 12 (150mg) vs 14 (placebo)",
      "ACD/non-fatal MI/SRI/non-haemorrhagic stroke composite: 25 (50mg), 27 (75mg), 21 (110mg), 25 (150mg) vs 26 (placebo)",
      "All-cause death: 8 (50mg), 10 (75mg), 7 (110mg), 7 (150mg) vs 14 (placebo)"
    ],
    "safety_signals": [
      "Dose-dependent increase in major and clinically relevant minor bleeding with dabigatran (p<0.001 for trend)",
      "Higher rates of any bleeding in all dabigatran arms vs placebo",
      "Serious cardiac adverse events (angina, unstable angina, cardiac failure) distributed across arms"
    ],
