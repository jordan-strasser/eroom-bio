    "proposed_mechanism": "kinase inhibition",
    "intended_biology": "aberrant FGFR signaling suppression / tumor cell proliferation inhibition",
    "target_population": "Adults with advanced urothelial cancer harboring selected FGFR gene aberrations, previously treated",
    "primary_endpoint": "Overall Survival (OS)",
    "rationale_strength": "strong"
  },
  "results": {
    "primary_endpoint_met": true,
    "effect_size": "Cohort 1: HR=0.65 (95% CI 0.48\u20130.86); Cohort 2: HR=1.16 (95% CI 0.92\u20131.48)",
    "p_value": 0.0031,
    "target_engagement_evidence": "Hyperphosphatemia observed in erdafitinib arms (consistent with FGFR inhibition and phosphate regulation)",
    "biomarker_changes": [
      "Hyperphosphatemia Grade 3: 6 participants in Cohort 1 Arm 1A (erdafitinib) vs 0 in chemotherapy arm",
      "Hypophosphatemia Grade 3 shifts more frequent in erdafitinib arms",
      "Hyponatremia Grade 3 shifts more frequent in erdafitinib arms (14 in Cohort 1 Arm 1A vs 2 in chemotherapy)",
      "Weight loss greater in erdafitinib arms (mean -5.95 kg Cohort 1 Arm 1A vs -1.23 kg chemotherapy)",
      "Ophthalmologic changes (subretinal fluid, RPE elevation, visual acuity worsening) observed in erdafitinib arms only"
    ],
    "subgroup_findings": [
      "Cohort 1 (erdafitinib vs chemotherapy): OS HR=0.65, p=0.0031 \u2014 erdafitinib superior",
      "Cohort 2 (erdafitinib vs pembrolizumab): OS HR=1.16, p=0.2121 \u2014 no significant difference",
      "Cohort 1 ORR: erdafitinib 46.9% vs chemotherapy 12.6%",
      "Cohort 2 ORR: erdafitinib 40.0% vs pembrolizumab 21.6%",
      "Pembrolizumab DOR notably longer (15.21 months) vs erdafitinib (4.67 months) in Cohort 2",
      "Neutropenia/myelosuppression substantially higher in chemotherapy arm"
    ],
    "safety_signals": [
      "Ophthalmologic toxicity (Amsler grid abnormalities, visual acuity worsening, subretinal fluid, RPE elevation) observed exclusively in erdafitinib arms",
      "Hyperphosphatemia Grade 3\u20134 observed in erdafitinib arms, consistent with FGFR inhibition",
      "Hyponatremia Grade 3\u20134 more frequent in erdafitinib arms",
      "Weight loss greater in erdafitinib arms",
      "Febrile neutropenia (8/117), febrile bone marrow aplasia (4/117), neutropenia (3/117) in chemotherapy arm",
      "Myelosuppression predominant in chemotherapy arm"
    ],
