{
  "nct_id": "NCT02211131",
  "therapeutic_hypothesis": {
    "compound": "Talimogene Laherparepvec",
    "claimed_target": "oncolytic virus",
    "proposed_mechanism": "intralesional injection of oncolytic herpes simplex virus to induce tumor lysis and immune activation",
    "intended_biology": "direct tumor cell killing and immune system activation against melanoma",
    "target_population": "patients with completely resectable stage IIIB, IIIC, or IVM1a melanoma",
    "primary_endpoint": "Recurrence-Free Survival (RFS)",
    "rationale_strength": "moderate"
  },
  "results": {
    "primary_endpoint_met": false,
    "effect_size": "HR 0.75 (80% CI: 0.58-0.96)",
    "p_value": 0.07,
    "target_engagement_evidence": "26.3% objective response rate in injected lesions, 3.9% in uninjected lesions",
    "biomarker_changes": [],
    "subgroup_findings": [
      "Pathological complete response rate significantly higher with talimogene laherparepvec: 17.1% vs 2.7% (p=0.003)",
      "Overall survival benefit at 5 years: 77.32% vs 62.29% (HR 0.54, p=0.050)"
    ],
    "safety_signals": [
      "Well tolerated overall",
      "Most common serious AEs were cellulitis (2.7%), and individual cases of nausea, small intestinal obstruction, asthenia, pain, pyrexia, cholecystitis, influenza, postoperative wound infection, urinary tract infection",
      "No fatal adverse events related to treatment"
    ],
    "dose_info": {
      "dose": "10^6 PFU/mL initially, then 10^8 PFU/mL",
      "schedule": "day 1 week 1, then weeks 4, 6, 8, 10, 12",
      "max_tolerated_dose": "",
      "dose_modifications": "3 participants had dose reductions to <4 mL administered"
    },
