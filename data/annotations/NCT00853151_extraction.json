{
  "nct_id": "NCT00853151",
  "therapeutic_hypothesis": {
    "compound": "LY2428757 plus TT223",
    "claimed_target": "unknown (LY2428757 and TT223 targets not disclosed)",
    "proposed_mechanism": "unknown",
    "intended_biology": "glycemic control improvement in type 2 diabetes",
    "target_population": "Adults with type 2 diabetes mellitus on metformin or diet and exercise",
    "primary_endpoint": "Change from baseline in HbA1c at 6 months",
    "rationale_strength": "unclear"
  },
  "results": {
    "primary_endpoint_met": false,
    "effect_size": "LY2428757+TT223 3mg: -0.08% HbA1c; LY2428757+TT223 2mg: +0.06% HbA1c; LY2428757+placebo: -0.15% HbA1c; placebo+placebo: +0.04% HbA1c at 6 months",
    "p_value": 0.623,
    "target_engagement_evidence": "PK data collected for TT223 (Cmax ~8.5 ng/mL first dose); LY2428757 PK insufficient timepoints for modeling",
    "biomarker_changes": [
      "HbA1c reduction at 4 weeks: -0.81% (3mg combo), -0.97% (2mg combo), -0.79% (LY2428757+placebo), -0.19% (placebo) \u2014 short-term effect not sustained",
      "Fasting blood glucose at 4 weeks: -0.7 mmol/L (3mg), -1.6 mmol/L (2mg), -1.6 mmol/L (LY2428757+placebo), +0.5 mmol/L (placebo)",
      "MMTT glucose AUC at 3 weeks: all active arms showed smaller increases vs placebo (+28.47 mmol/L*hr)",
      "HOMA-B at 3 weeks: +19.12 (3mg), +34.73 (2mg), +37.76 (LY2428757+placebo), -14.99 (placebo)",
      "Lipase elevation at 4 weeks: +14.8 U/L (3mg), +10.1 U/L (2mg), +40.5 U/L (LY2428757+placebo)",
      "No antibodies to TT223 detected in any arm; 1 participant each in LY2428757+TT223 3mg and 2mg arms had antibodies to LY2428757"
    ],
    "subgroup_findings": [
      "Patients with diabetes duration <3 years showed greater HbA1c reduction: -0.87% (3mg), -0.77% (2mg) vs +0.18% (LY2428757+placebo)",
      "Elevated C-peptide subgroup: -0.30% (3mg), -0.78% (2mg) vs +0.06% (LY2428757+placebo)",
      "No statistically significant subgroup interactions found; adjusted MMTT and FBG subgroup analyses not performed due to lack of significant primary subgroup findings"
    ],
    "safety_signals": [
      "Nausea VAS scores higher in combo arms at 4 weeks (22.0 and 27.6) vs LY2428757+placebo (11.9) and placebo (9.1)",
      "Low incidence of hypoglycemia across all arms (1-3 participants per arm)",
      "2 adjudicated CV events in LY2428757+TT223 3mg arm; 1 in placebo arm",
      "Lipase elevations observed, particularly in LY2428757+placebo arm at 4 weeks (+40.5 U/L); 2% of LY2428757+placebo participants had lipase >=2x ULN"
    ],
    "dose_info": {
      "dose": "LY2428757: 14 mg subcutaneous; TT223: 2 mg or 3 mg subcutaneous",
      "schedule": "LY2428757: once weekly x5 weeks; TT223: once daily x4 weeks",
