    "proposed_mechanism": "receptor agonism",
    "intended_biology": "glucose-dependent insulin secretion and glycemic control",
    "target_population": "adults with type 2 diabetes",
    "primary_endpoint": "change from baseline in HbA1c after 12 weeks",
    "rationale_strength": "strong"
  },
  "results": {
    "primary_endpoint_met": true,
    "effect_size": "semaglutide 1.6 mg (with titration): -1.5% HbA1c vs placebo -0.5%; estimated treatment difference -1.19% (95% CI: -1.58 to -0.80) for highest dose vs placebo",
    "p_value": 0.0001,
    "target_engagement_evidence": null,
    "biomarker_changes": [
      "Dose-dependent reduction in HbA1c across semaglutide doses (0.1 mg: -0.6%, 0.2 mg: -0.9%, 0.4 mg: -1.0%, 0.8 mg: -1.4%, 1.6 mg: -1.5%) vs placebo -0.5%",
      "Dose-dependent reduction in systolic blood pressure (up to -7.7 mmHg with semaglutide 0.8 mg titration)",
      "Modest dose-dependent increase in pulse rate (up to +3.9 bpm with semaglutide 1.6 mg)",
      "Reductions in ALT and AST at higher semaglutide doses",
      "Calcitonin changes were small and not clearly dose-dependent",
      "No anti-semaglutide antibodies detected except 3% in semaglutide 1.6 mg arm",
      "Urine glucose negativity increased with higher semaglutide doses, consistent with improved glycemic control"
    ],
    "subgroup_findings": [
      "No major hypoglycemic episodes in any arm",
      "Minor hypoglycemia: semaglutide 0.1 mg 4.3%, 0.4 mg 4.2%, 0.8 mg titration 2.3%; liraglutide 1.2 mg 4.4%, 1.8 mg 2.0%; placebo 0%"
    ],
    "safety_signals": [
      "Adverse event incidence increased with semaglutide dose (43.5% placebo to 93.6% semaglutide 1.6 mg)",
      "Serious adverse events included acute myocardial infarction, coronary artery disease, acute left ventricular failure, arterial occlusive disease, hypertension, myocardial infarction, epilepsy, herpes zoster, nephrolithiasis",
      "No major hypoglycemic episodes in any arm",
      "3% anti-semaglutide antibody rate in 1.6 mg titration arm"
    ],
    "dose_info": {
      "dose": "0.1 mg, 0.2 mg, 0.4 mg, 0.8 mg, 0.8 mg (with titration), 1.6 mg (with titration) for semaglutide; 1.2 mg and 1.8 mg for liraglutide",
      "schedule": "semaglutide: once weekly s.c.; liraglutide: once daily s.c.",
