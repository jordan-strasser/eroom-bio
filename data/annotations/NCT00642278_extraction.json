  "results": {
    "primary_endpoint_met": true,
    "effect_size": "LS mean difference vs placebo: -0.45% (50 mg QD), -0.51% (100 mg QD), -0.54% (200 mg QD), -0.71% (300 mg QD), -0.73% (300 mg BID), -0.56% (sitagliptin 100 mg QD)",
    "p_value": 0.001,
    "target_engagement_evidence": "Overnight urine glucose/creatinine ratio increased markedly with all canagliflozin doses (LS mean difference vs placebo: +36.1 to +60.3 mg/mg, p<0.001), confirming SGLT2 inhibition and renal glucose excretion; sitagliptin showed no significant change (-3.3 mg/mg, p=0.513).",
    "biomarker_changes": [
      "Overnight urine glucose/creatinine ratio increased from baseline by 35.4\u201361.6 mg/mg across canagliflozin doses vs 1.9 mg/mg for placebo",
      "Fasting plasma glucose decreased by 0.9\u20131.8 mmol/L (LS mean vs placebo) across canagliflozin doses",
      "Body weight decreased by 1.96\u20132.88 kg (absolute) across canagliflozin doses vs -0.78 kg for placebo"
    ],
