{
  "nct_id": "NCT00806026",
  "therapeutic_hypothesis": {
    "compound": "pregabalin",
    "claimed_target": "voltage-gated calcium channels (alpha-2-delta subunit)",
    "proposed_mechanism": "calcium channel modulation",
    "intended_biology": "neuronal excitability reduction / sensorimotor symptom relief",
    "target_population": "adults with idiopathic restless legs syndrome",
    "primary_endpoint": "change from baseline in IRLS total score at week 12; percentage of participants with augmentation over 52 weeks",
    "rationale_strength": "strong"
  },
  "results": {
    "primary_endpoint_met": true,
    "effect_size": "LS mean difference vs placebo: -4.50 (IRLS score, 95% CI -5.90 to -3.20); responder rate 71.4% vs 46.8% placebo; augmentation rate 1.7% vs 6.6% (PPX 0.25 mg) and 9.0% (PPX 0.5 mg)",
    "p_value": 0.0001,
    "target_engagement_evidence": null,
    "biomarker_changes": [],
    "subgroup_findings": [
      "Pregabalin 300 mg showed lower augmentation rate (1.7%) vs pramipexole 0.5 mg (9.0%), p=0.0012",
      "Pregabalin 300 mg showed greater reduction in subjective WASO vs placebo (LS mean difference -17.25 min, p<0.0001)",
      "Pramipexole 0.25 mg did not significantly differ from placebo on IRLS change (LS mean difference -0.6, p=0.3603)",
      "Pramipexole 0.5 mg significantly improved IRLS vs placebo (LS mean difference -3.2, p<0.0001)"
    ],
    "safety_signals": [
      "Somnolence and dizziness are known class effects of pregabalin",
      "Augmentation risk higher with pramipexole (dose-dependent: 6.6% at 0.25 mg, 9.0% at 0.5 mg) vs pregabalin (1.7%)",
      "Serious adverse events were infrequent and distributed across arms"
    ],
    "dose_info": {
      "dose": "300 mg (pregabalin); 0.25 mg or 0.5 mg (pramipexole)",
      "schedule": "once daily, 1-3 hours before bedtime",
