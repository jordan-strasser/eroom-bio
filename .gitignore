# Reproducible API + download caches
data/cache/

# Private / enterprise artifacts — SECOND layer only. The primary boundary is
# enforced in code at serialization time (src/boundary.py strips private
# values from public snapshots; export_private_snapshot writes only under
# EROOM_PRIVATE_ROOT, which must be OUTSIDE this repo). These patterns are a
# backstop so a stray private write can't be `git add`-ed by accident. They
# are NOT the boundary — never rely on them alone. See BOUNDARY.md.
data/private/
*.safetensors
*.pt
*.pth
*.bin
*.ckpt
*.npy
*.npz

# Regenerable graph snapshots (belief-state intermediates) — large + rebuildable
# via scripts/build_graph.py (... --assemble). Rule: a bottom-up build's PRE-MERGE
# union is always huge (100s of MB) and is a pure intermediate; the per-session
# experimental / A-B / scratch snapshots (b1_*, *_reattr*, rebuild_*, t4b_*,
# phaseb_*, phasec_*, neff*) are regenerable too. This is a backstop so a future
# `git add -A` can't sweep them in again (the cause of the 2.5 GB blob incident).
# NOTE: gitignore never un-tracks an already-committed path — the deliberately
# PUBLISHED public snapshots (onco_scale_500_annotated.json, multi_500_*) stay
# tracked. This only blocks NEW untracked bloat. See CLEANUP_MERGE_REPORT.md.
# Always-intermediate: a build's pre-merge union + re-attribution outputs.
data/exports/*premerge*.json
data/exports/*_reattr*.json
# Per-session experimental / A-B / scratch build families (regenerable). The
# deliberately-published baseline families STAY tracked: mi_bu*, mi_td*, mi_v2*,
# multi_indication_*, onco_scale_500_{annotated,initial}, oncology_*.
data/exports/b1_*.json
data/exports/multi_500_*.json
data/exports/neff*.json
data/exports/onco_scale_252_*.json
data/exports/onco_scale_500_enr_*.json
data/exports/mi_oc52_*.json
data/exports/rebuild_*.json
data/exports/t4b_*.json
data/exports/phaseb_n*.json
data/exports/phasec_n*.json

# Regenerable working artifacts: dev scratch outputs + HTML graph visualizations.
data/dev/
data/viz/

# Local scratch / out-of-baseline notes
onboarding/

# Per-round audit notes, design docs, inspection snapshots, and the
# automated debug-loop playbook. Local-only — these are the operator's
# working notes rather than published artifacts.
audit/
automate_node_debug.md
NEXT_SESSION.md

